generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum RoleName {
  ADMIN
  MANAGEMENT
  OUTLET_MANAGER
}

enum OutletType {
  OUTLET
  PREP_KITCHEN
  ADMIN
}

enum ApiType {
  SALES
  PURCHASE
  INVENTORY
  TRANSFER
}

enum SyncType {
  SALES
  INVENTORY
  PURCHASE
  HISTORICAL
  TRANSFER
}

enum TriggerType {
  CRON
  MANUAL
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum InventoryTransactionType {
  OPENING
  PURCHASE
  CONSUMPTION
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum DataSource {
  PETPOOJA
  STUB
  MANUAL
}

enum ClassAItemType {
  ITEM
  CATEGORY
}

// ---------- Core entities ----------

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  outletId     String?
  outlet       Outlet?   @relation(fields: [outletId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  syncLogs             SyncLog[]
  notificationSettings NotificationSetting?
}

model Outlet {
  id                 String     @id @default(cuid())
  name               String
  brand              String
  rid                String     @unique
  outletType         OutletType @default(OUTLET)
  city               String?
  address            String?
  isActive           Boolean    @default(true)
  salesSyncCode      String?
  inventorySyncCode  String?
  lowStockAlertEnabled Boolean  @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  users                 User[]
  sales                 Sale[]
  inventory             Inventory[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders        PurchaseOrder[]
  syncLogs              SyncLog[]
}

model Sale {
  id              String   @id @default(cuid())
  outletId        String
  outlet          Outlet   @relation(fields: [outletId], references: [id])
  invoiceNumber   String
  petpoojaOrderId String?
  orderDateTime   DateTime
  orderDate       DateTime @db.Date
  customerName    String?
  customerPhone   String?
  grossAmount     Decimal  @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal  @default(0) @db.Decimal(12, 2)
  netAmount       Decimal  @db.Decimal(12, 2)
  paymentMode     String
  orderType       String?
  rawPayload      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items SaleItem[]

  @@unique([outletId, invoiceNumber])
  @@index([outletId, orderDate])
  @@index([orderDate])
}

model SaleItem {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemName   String
  category   String?
  quantity   Decimal  @db.Decimal(10, 2)
  price      Decimal  @db.Decimal(12, 2)
  discount   Decimal  @default(0) @db.Decimal(12, 2)
  tax        Decimal  @default(0) @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([itemName])
  @@index([category])
}

model Inventory {
  id                String     @id @default(cuid())
  outletId          String
  outlet            Outlet     @relation(fields: [outletId], references: [id])
  itemName          String
  category          String?
  unit              String?
  store             String?
  openingStock      Decimal    @default(0) @db.Decimal(12, 2)
  purchasedQty      Decimal    @default(0) @db.Decimal(12, 2)
  consumedQty       Decimal    @default(0) @db.Decimal(12, 2)
  closingStock      Decimal    @default(0) @db.Decimal(12, 2)
  currentStock      Decimal    @default(0) @db.Decimal(12, 2)
  unitValue         Decimal    @default(0) @db.Decimal(12, 2)
  stockValue        Decimal    @default(0) @db.Decimal(12, 2)
  lowStockThreshold Decimal?   @db.Decimal(12, 2)
  isLowStock        Boolean    @default(false)
  stockDate         DateTime   @db.Date
  source            DataSource @default(STUB)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([outletId, itemName, stockDate])
  @@index([outletId, stockDate])
}

model InventoryTransaction {
  id                  String                    @id @default(cuid())
  outletId            String
  outlet              Outlet                    @relation(fields: [outletId], references: [id])
  itemName            String
  transactionType     InventoryTransactionType
  quantity            Decimal                   @db.Decimal(12, 2)
  unit                String?
  referenceType       String?
  referenceId         String?
  sourceOutletId      String?
  destinationOutletId String?
  transactionDate     DateTime
  rawPayload          Json?
  source              DataSource                @default(STUB)
  createdAt           DateTime                  @default(now())

  @@index([outletId, transactionDate])
  @@index([itemName])
}

model Vendor {
  id                String   @id @default(cuid())
  name              String
  petpoojaSupplierId String? @unique
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  poNumber           String
  petpoojaPurchaseId String?
  outletId           String
  outlet             Outlet              @relation(fields: [outletId], references: [id])
  vendorId           String?
  vendor             Vendor?             @relation(fields: [vendorId], references: [id])
  invoiceNumber      String?
  status             PurchaseOrderStatus @default(PENDING)
  totalAmount        Decimal             @db.Decimal(12, 2)
  taxAmount          Decimal             @default(0) @db.Decimal(12, 2)
  orderDate          DateTime
  expectedDate       DateTime?
  receivedDate       DateTime?
  rawPayload         Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@unique([outletId, poNumber])
  @@index([outletId, orderDate])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemName        String
  quantity        Decimal       @db.Decimal(12, 2)
  unit            String?
  rate            Decimal       @db.Decimal(12, 2)
  amount          Decimal       @db.Decimal(12, 2)
  cgst            Decimal       @default(0) @db.Decimal(12, 2)
  sgst            Decimal       @default(0) @db.Decimal(12, 2)
  igst            Decimal       @default(0) @db.Decimal(12, 2)
  cess            Decimal       @default(0) @db.Decimal(12, 2)
  receivedQty     Decimal       @default(0) @db.Decimal(12, 2)
  pendingQty      Decimal       @default(0) @db.Decimal(12, 2)
}

model SyncLog {
  id                String      @id @default(cuid())
  syncType          SyncType
  triggerType       TriggerType
  outletId          String?
  outlet            Outlet?     @relation(fields: [outletId], references: [id])
  status            SyncStatus
  startedAt         DateTime    @default(now())
  completedAt       DateTime?
  recordsFetched    Int         @default(0)
  recordsCreated    Int         @default(0)
  recordsUpdated    Int         @default(0)
  recordsFailed     Int         @default(0)
  errorMessage      String?
  triggeredByUserId String?
  triggeredByUser   User?       @relation(fields: [triggeredByUserId], references: [id])
  createdAt         DateTime    @default(now())

  @@index([syncType, outletId, createdAt])
}

model PetpoojaApiConfig {
  id                    String    @id @default(cuid())
  apiType               ApiType   @unique
  appKeyEncrypted       String?
  appSecretEncrypted    String?
  accessTokenEncrypted  String?
  cookieEncrypted       String?
  isConfigured          Boolean   @default(false)
  lastVerifiedAt        DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model SyncSchedule {
  id              String   @id @default(cuid())
  syncType        SyncType @unique
  cronExpression  String
  isEnabled       Boolean  @default(true)
  lastRunAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NotificationSetting {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  lowStockAlerts      Boolean  @default(true)
  syncFailureAlerts   Boolean  @default(true)
  dailySummaryEmail   Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model ClassAItem {
  id        String         @id @default(cuid())
  brand     String
  type      ClassAItemType
  value     String
  createdAt DateTime       @default(now())

  @@unique([brand, type, value])
}
